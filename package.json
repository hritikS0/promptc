{
  "name": "@hritik123/promptc",
  "version": "1.0.3",
  "description": "CLI tool for turning raw developer prompts into structured AI instructions",
  "main": "./dist/cli/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli/index.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "prompt",
    "cli",
    "developer-tools",
    "nvidia"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hritikS0/promptc.git"
  },
  "bugs": {
    "url": "https://github.com/hritikS0/promptc/issues"
  },
  "homepage": "https://github.com/hritikS0/promptc#readme",
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "promptc": "dist/cli/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.0",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "dotenv": "^17.4.2",
    "openai": "^7.17.0",
    "ora": "^9.4.1",
    "zod": "^4.6.5"
  }
}
